DELIMITER $$

CREATE PROCEDURE buscar_alunos_por_idade(idade_minima INT)
BEGIN
    SELECT id, nome, idade, turma 
    FROM alunos 
    WHERE idade >= idade_minima;
END$$

DELIMITER ;

CALL buscar_alunos_por_idade(18);
